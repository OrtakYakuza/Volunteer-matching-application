// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Prisma schema for volunteer matching prototype

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "sqlite"
  url       = "file:./dev.db"
}

// ---------- Enums ----------

// SQLite does not support enums natively like PostgreSQL, so we map them as String fields.
// The types remain strongly typed in TypeScript due to the generator!

model Volunteer {
  id          String         @id @default(cuid())
  name        String         // IR-01
  email       String         @unique // IR-01
  phoneNumber String
  birthDate   DateTime
  postalCode  String?        // IR-06
  location    String?        // optional free-text region
  description String?        // optional text box for volunteer to write about themselves
  // SQLite doesn't support arrays of strings easily, we will store them as a JSON string
  skills      String         // Stored as JSON stringified array of Skills
  assignments Assignment[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Coordinator {
  id          String         @id @default(cuid())
  name        String
  email       String         @unique
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model Task {
  id             String         @id @default(cuid())
  title          String         // human-readable task/mission name
  category       String         // IR-08
  description    String         // IR-08
  location       String         // IR-08 (e.g. address or site name)
  postalCode     String?        // IR-06 / IR-09 (for matching)
  requiredSkills String         // Stored as JSON stringified array of Skills
  capacity       Int            // FR-28, IR-08 (max volunteers)
  startTime      DateTime       // IR-09
  endTime        DateTime       // IR-09
  priority       String         @default("MEDIUM") // Priority enum
  status         String         @default("OPEN")   // TaskStatus enum
  automationMode String         @default("MANUAL") // AutomationMode enum
  meetingPoint   String?        // FR-06 (optional)
  screeningRequired Boolean?    // FR-26
  screeningNote    String?      // FR-26
  assignments      Assignment[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Assignment {
  id           String           @id @default(cuid())
  volunteer    Volunteer        @relation(fields: [volunteerId], references: [id])
  volunteerId  String
  task         Task             @relation(fields: [taskId], references: [id])
  taskId       String
  status       String           @default("PROPOSED") // AssignmentStatus enum
  automationMode String?          // AutomationMode enum
  duties       String?          // IR-13
  contactPoint String?          // IR-13
  explanation  String?          // NFR-10 (why this match)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([volunteerId, taskId]) // FR-14: Prevents duplicate pairs
}

// ---------- Audit / event log (optional, for NFR-04, IR-14) ----------

model EventLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  actorType String   // e.g. "COORDINATOR" | "VOLUNTEER" | "SYSTEM"
  actorId   String?  // optional reference ID
  eventType String   // e.g. "VOLUNTEER_REGISTERED", "TASK_CREATED", etc.
  payload   String?    // arbitrary event details as JSON string
}
