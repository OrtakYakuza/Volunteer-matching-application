// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Volunteer {
  id           String       @id @default(cuid())
  name         String       // IR-01
  email        String       @unique // IR-01
  skills       String[]     // IR-02, IR-03
  availability Json         // IR-04
  location     String?      // IR-06
  assignments  Assignment[]
  createdAt    DateTime     @default(now())
}

model Task {
  id             String       @id @default(cuid())
  category       String       // IR-08
  description    String       // IR-08
  location       String       // IR-08
  requiredSkills String[]     // IR-08
  capacity       Int          // FR-28, IR-08
  startTime      DateTime     // IR-09
  endTime        DateTime     // IR-09
  priority       String       // IR-10
  status         String       @default("open") // FR-30
  automationMode String       @default("manual") // FR-09
  assignments    Assignment[]
  createdAt      DateTime     @default(now())
}

model Assignment {
  id           String    @id @default(cuid())
  volunteer    Volunteer @relation(fields: [volunteerId], references: [id])
  volunteerId  String
  task         Task      @relation(fields: [taskId], references: [id])
  taskId       String
  status       String    @default("proposed") // IR-07, FR-11
  duties       String?   // IR-13
  contactPoint String?   // IR-13
  createdAt    DateTime  @default(now())

  @@unique([volunteerId, taskId]) // FR-14: Prevents double-booking
}